package org.placepro.controller;

import java.io.IOException;
import java.io.PrintWriter;
import java.util.List;

import org.placepro.dao.PlacementDao;
import org.placepro.daoImpl.PlacementDaoImpl;
import org.placepro.model.Placement;

import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@WebServlet("/placementTracker")
public class PlacementTrackerServlet extends HttpServlet {
    private PlacementDao placementDao = new PlacementDaoImpl();

    @Override
    protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws IOException {
        resp.setContentType("text/html");
        PrintWriter out = resp.getWriter();

        List<Placement> placements = placementDao.getAllPlacements();

        out.println("<!DOCTYPE html>");
        out.println("<html><head><title>Placement Tracker</title>");
        out.println("<link href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css' rel='stylesheet'>");
        out.println("<style>");
        out.println(".badge-applied { background:orange; }");
        out.println(".badge-selected { background:green; }");
        out.println(".badge-rejected { background:red; }");
        out.println("</style>");
        out.println("</head><body>");

        out.println("<div class='container mt-4'>");
        out.println("<h2>Placement Tracker</h2>");
        out.println("<table class='table table-hover table-bordered'>");
        out.println("<thead class='table-light'><tr>");
        out.println("<th>ID</th><th>Name</th><th>Email</th><th>Course</th><th>Education</th><th>Company</th><th>Package</th><th>Status</th><th>Actions</th>");
        out.println("</tr></thead><tbody>");

        for (Placement p : placements) {
            String badgeClass = "badge-applied";
            if ("Selected".equalsIgnoreCase(p.getStatus())) badgeClass = "badge-selected";
            else if ("Rejected".equalsIgnoreCase(p.getStatus())) badgeClass = "badge-rejected";

            out.println("<tr>");
            out.println("<td>" + p.getId() + "</td>");
            out.println("<td>" + p.getStudentName() + "</td>");
            out.println("<td>" + p.getEmail() + "</td>");
            out.println("<td>" + p.getCourse() + "</td>");
            out.println("<td>" + p.getEducation() + "</td>");
            out.println("<td>" + p.getCompanyName() + "</td>");
            out.println("<td>" + p.getPackageAmount() + "</td>");
            out.println("<td><span class='badge " + badgeClass + "'>" + p.getStatus() + "</span></td>");
            out.println("<td>");
            out.println("<form method='post' action='updateStatus'>");
            out.println("<input type='hidden' name='placementId' value='" + p.getId() + "'/>");
            out.println("<button class='btn btn-success btn-sm' name='status' value='Selected'>Select</button>");
            out.println("<button class='btn btn-danger btn-sm' name='status' value='Rejected'>Reject</button>");
            out.println("</form>");
            out.println("</td>");
            out.println("</tr>");
        }

        out.println("</tbody></table>");
        out.println("</div></body></html>");
    }

    @Override
    protected void doPost(HttpServletRequest req, HttpServletResponse resp) throws IOException {
        doGet(req, resp);
    }
}
