<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Coordinator Team</title>

<!-- GOOGLE FONT -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- FONT AWESOME ICONS -->
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>

/* RESET */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    min-height:100vh;
    background:linear-gradient(135deg,#020617,#0f172a,#1e3a8a,#2563eb);
    background-size:400% 400%;
    animation:bgAnimation 12s ease infinite;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
    padding:40px;
    position:relative;
}

/* BACKGROUND ANIMATION */

@keyframes bgAnimation{
    0%{
        background-position:0% 50%;
    }
    50%{
        background-position:100% 50%;
    }
    100%{
        background-position:0% 50%;
    }
}

.circle{
    position:absolute;
    border-radius:50%;
    background:rgba(255,255,255,0.08);
    animation:float 8s infinite ease-in-out;
}

.circle1{
    width:250px;
    height:250px;
    top:-70px;
    left:-70px;
}

.circle2{
    width:180px;
    height:180px;
    bottom:-50px;
    right:-50px;
    animation-delay:2s;
}

.circle3{
    width:120px;
    height:120px;
    top:50%;
    left:45%;
    animation-delay:4s;
}

@keyframes float{
    0%{
        transform:translateY(0px);
    }
    50%{
        transform:translateY(-25px);
    }
    100%{
        transform:translateY(0px);
    }
}

/* MAIN CONTAINER */

.container{
    width:100%;
    max-width:1150px;
    position:relative;
    z-index:10;
}

/* HEADING */

.heading{
    text-align:center;
    color:white;
    font-size:55px;
    margin-bottom:55px;
    font-weight:700;
    letter-spacing:2px;
    text-shadow:0 0 25px rgba(255,255,255,0.4);
    animation:fadeDown 1s ease;
}

.heading span{
    color:#facc15;
}

/* HEADING ANIMATION */

@keyframes fadeDown{
    from{
        opacity:0;
        transform:translateY(-50px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* CARD LAYOUT */

.coordinator-box{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:40px;
}

/* CARD */

.card{
    position:relative;
    background:rgba(255,255,255,0.12);
    border:1px solid rgba(255,255,255,0.2);
    backdrop-filter:blur(18px);
    border-radius:30px;
    padding:40px 30px;
    text-align:center;
    overflow:hidden;
    transition:0.5s;
    box-shadow:0 12px 35px rgba(0,0,0,0.35);
    animation:zoomIn 1s ease;
}

/* CARD TOP GLOW */

.card::before{
    content:'';
    position:absolute;
    top:-80px;
    left:-80px;
    width:180px;
    height:180px;
    background:rgba(255,255,255,0.15);
    border-radius:50%;
}

/* CARD HOVER */

.card:hover{
    transform:translateY(-12px) scale(1.03);
    box-shadow:0 18px 50px rgba(0,0,0,0.5);
}

/* CARD ANIMATION */

@keyframes zoomIn{
    from{
        opacity:0;
        transform:scale(0.7);
    }
    to{
        opacity:1;
        transform:scale(1);
    }
}

/* IMAGE */

.card img{
    width:190px;
    height:190px;
    object-fit:cover;
    border-radius:50%;
    border:6px solid white;
    margin-bottom:22px;
    transition:0.5s;
    box-shadow:0 0 30px rgba(255,255,255,0.3);
}

.card:hover img{
    transform:scale(1.08) rotate(3deg);
}

/* ROLE */

.role{
    display:inline-block;
    background:#facc15;
    color:#0f172a;
    padding:8px 20px;
    border-radius:30px;
    font-size:18px;
    font-weight:700;
    margin-bottom:18px;
    box-shadow:0 4px 15px rgba(250,204,21,0.5);
}

/* NAME */

.name{
    color:white;
    font-size:32px;
    font-weight:700;
    margin-bottom:20px;
}

/* INFO */

.info{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:12px;
    color:#e2e8f0;
    font-size:18px;
    margin-bottom:15px;
    transition:0.3s;
}

.info:hover{
    transform:scale(1.05);
}

.info i{
    width:45px;
    height:45px;
    line-height:45px;
    text-align:center;
    border-radius:50%;
    background:rgba(255,255,255,0.15);
    color:#facc15;
    font-size:18px;
}

/* EMAIL LINK */

.email{
    color:#bfdbfe;
    text-decoration:none;
    transition:0.3s;
}

.email:hover{
    color:#ffffff;
    text-decoration:underline;
}

/* MOBILE */

@media(max-width:850px){

.coordinator-box{
    grid-template-columns:1fr;
}

.heading{
    font-size:38px;
}

.card{
    padding:35px 20px;
}

}

</style>
</head>

<body>

