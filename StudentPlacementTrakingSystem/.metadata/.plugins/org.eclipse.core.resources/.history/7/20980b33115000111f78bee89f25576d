<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard - PlacePro</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
:root {
    --sidebar-width: 260px;
    --primary-blue: #4680ff;
    --bg-light: #eef2ff;
}

/* ✅ BETTER BACKGROUND */
body {
    margin: 0;
    font-family: 'Inter', 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, #eef2ff, #f8f9fd);
}

/* SIDEBAR */
.sidebar {
    width: var(--sidebar-width);
    height: 100vh;
    position: fixed;
    background: white;
    border-right: 1px solid #e5e7eb;
    z-index: 1000;
}

.sidebar-header {
    padding: 25px;
    border-bottom: 1px solid #f1f1f1;
}

.sidebar-user {
    padding: 15px;
    margin: 15px;
    background: #f4f7fe;
    border-radius: 12px;
    display: flex;
    align-items: center;
}

.user-img {
    width: 35px;
    height: 35px;
    border-radius: 8px;
    margin-right: 12px;
    background: #ddd;
}

.nav-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #9aa4b2;
    padding: 20px 25px 10px;
}

/* NAV ITEMS */
.sidebar a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 25px;
    color: #5b6b79;
    text-decoration: none;
    font-size: 14px;
    border-radius: 8px;
    margin: 4px 10px;
    transition: 0.2s;
}

.sidebar a:hover {
    background: #eef3ff;
    transform: scale(1.05);
    color: var(--primary-blue);
}

.sidebar a.active {
    background: #e9f0ff;
    color: var(--primary-blue);
    border-right: 3px solid var(--primary-blue);
}

/* 🚪 SPECIAL LOGOUT BUTTON */
.logout {
    color: white !important;
    background: #ef4444;
    margin-top: 15px;
}

.logout:hover {
    background: #dc2626 !important;
    color: white !important;
    transform: scale(1.05);
}

/* HEADER */
.top-header {
    margin-left: var(--sidebar-width);
    height: 70px;
    background: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
    position: sticky;
    top: 0;
    border-bottom: 1px solid #e5e7eb;
}

/* SEARCH */
.search-box {
    background: #f3f5f9;
    border: none;
    border-radius: 8px;
    padding: 8px 15px;
    width: 250px;
}

/* MAIN */
.main {
    margin-left: var(--sidebar-width);
    padding: 30px;
}

/* HERO */
.hero-banner {
    background: linear-gradient(135deg, #4680ff 0%, #2b57d5 100%);
    border-radius: 16px;
    padding: 40px;
    color: white;
    margin-bottom: 30px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

/* CARDS */
.card-box {
    background: white;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid #e5e7eb;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    transition: 0.3s;
}

.card-box:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 15px 30px rgba(0,0,0,0.18);
}

/* TABLE */
.table-card {
    background: white;
    border-radius: 12px;
    padding: 25px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
}

/* ICON ALIGN */
.sidebar i {
    font-size: 18px;
}

.user-img {
    width: 35px;
    height: 35px;
    border-radius: 8px;
    background: #4680ff;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 14px;
}
</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">

    <div class="sidebar-header">
        <h5 class="fw-bold text-primary mb-0">Place<span class="text-muted">Pro</span></h5>
    </div>

    <div class="sidebar-user">
        <div class="user-img">A</div>
        <div>
            <div class="fw-bold" style="font-size:13px;">Admin</div>
            <div style="font-size:11px;color:#777;">Administrator</div>
        </div>
    </div>

    <div class="nav-label">Navigation</div>

   
    <a class="active" href="/StudentPlaceTrackingSytem/admindashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <a><i class="bi bi-people" href="/StudentPlaceTrackingSytem/managestudent"></i> Manage Students</a>
    <a><i class="bi bi-building" href="/StudentPlaceTrackingSytem/managecompany"></i> Manage Companies</a>
    <a><i class="bi bi-journal-text" href="/StudentPlaceTrackingSytem/placementTracker"></i> Placement Tracker</a>
    <a><i class="bi bi-clipboard-check"></i> Applications</a>
    <a><i class="bi bi-trophy"></i> Success Stories</a>

    <div class="nav-label">Account</div>

    <a class="logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
</div>

<!-- HEADER -->
<div class="top-header">

    <input type="text" class="search-box" placeholder="Search Students / Company">

    <div>
        <i class="bi bi-bell fs-5"></i>
        <i class="bi bi-gear fs-5 ms-3"></i>
    </div>

</div>

<!-- MAIN -->
<div class="main">

    <!-- HERO -->
    <div class="hero-banner">
        <h2>Welcome Admin</h2>
        <p>Track. Analyze. Manage. Grow.</p>
    </div>

    <!-- CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card-box">
                <i class="bi bi-people fs-3 text-primary"></i>
                <h5>Total Students</h5>
                <div class="fs-3 fw-bold">0</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-box">
                <i class="bi bi-building fs-3 text-success"></i>
                <h5>Companies</h5>
                <div class="fs-3 fw-bold">0</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-box">
                <i class="bi bi-clipboard-data fs-3 text-warning"></i>
                <h5>Applications</h5>
                <div class="fs-3 fw-bold">0</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-box">
                <i class="bi bi-trophy fs-3 text-danger"></i>
                <h5>Selected</h5>
                <div class="fs-3 fw-bold">0</div>
            </div>
        </div>

    </div>

    <!-- TABLE -->
    <div class="table-card">
        <h5>Placement Applications</h5>
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Student</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Status</th>
                </tr>
            </thead>
        </table>
    </div>

</div>

</body>
</html>