<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Admin Dashboard - PlacePro</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

/* ===== LAYOUT ===== */
body {
    margin:0;
    font-family:'Segoe UI', sans-serif;
    background:#f1f5f9;
}

/* SIDEBAR */
.sidebar {
    width:250px;
    height:100vh;
    position:fixed;
    background:#0f172a;
    color:white;
    padding:20px;
}

.sidebar h4 {
    margin-bottom:30px;
}

.sidebar a {
    display:block;
    color:#cbd5f5;
    text-decoration:none;
    margin:15px 0;
}

.sidebar a:hover {
    color:white;
}

.logout-btn {
    background:#ef4444;
    border:none;
    padding:10px;
    width:100%;
    border-radius:8px;
    color:white;
}

/* MAIN CONTENT */
.main {
    margin-left:250px;
    padding:30px;
}

/* CARDS */
.card-box {
    border-radius:15px;
    padding:20px;
    background:white;
    box-shadow:0 4px 15px rgba(0,0,0,0.1);
}

.stat {
    font-size:30px;
    font-weight:bold;
}

/* TABLE */
.table-card {
    background:white;
    border-radius:15px;
    padding:20px;
    box-shadow:0 4px 15px rgba(0,0,0,0.1);
}

/* STATUS BADGES */
.badge-applied { background:orange; }
.badge-selected { background:green; }
.badge-rejected { background:red; }

</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">
    <h4>Admin Panel</h4>

    <a href="#">Dashboard</a>
    <a href="#">Manage Students</a>
    <a href="#">Manage Companies</a>
    <a href="#">Placement Tracker</a>
    <a href="#">Success Stories</a>

    <button class="logout-btn mt-4">Logout</button>
</div>

<!-- MAIN -->
<div class="main">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>Admin Dashboard</h3>
            <p>Welcome, Admin 👋</p>
        </div>
        <button class="btn btn-primary" onclick="addCompany()">Add Company</button>
    </div>

    <!-- STATS -->
    <div class="row mb-4" id="stats">
        <div class="col-md-3">
            <div class="card-box">
                <p>Total Students</p>
                <div class="stat text-primary" id="studentsCount">0</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-box">
                <p>Total Companies</p>
                <div class="stat text-success" id="companyCount">0</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-box">
                <p>Applications</p>
                <div class="stat text-warning" id="applicationCount">0</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-box">
                <p>Selected Students</p>
                <div class="stat text-info" id="selectedCount">0</div>
            </div>
        </div>
    </div>

    <!-- SEARCH -->
    <input type="text" id="search" class="form-control mb-3"
           placeholder="Search Students / Companies"
           onkeyup="searchTable()">

    <!-- TABLE -->
    <div class="table-card">
        <h5>Placement Applications</h5>

        <table class="table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Company</th>
                    <th>Package</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody id="tableBody">
            </tbody>
        </table>
    </div>

</div>

<!-- SCRIPT -->
<script>

// ===== SAMPLE DATA =====
let data = [
    {name:"Rutuja", company:"TCS", package:"4 LPA", status:"Applied"},
    {name:"Amit", company:"Infosys", package:"5 LPA", status:"Selected"},
    {name:"Priya", company:"Wipro", package:"3.5 LPA", status:"Rejected"}
];

// ===== LOAD DATA =====
function loadTable(){
    let table = document.getElementById("tableBody");
    table.innerHTML = "";

    let selected = 0;

    data.forEach((d, index) => {

        let badgeClass = "badge-applied";

        if(d.status === "Selected"){
            badgeClass = "badge-selected";
            selected++;
        }
        if(d.status === "Rejected"){
            badgeClass = "badge-rejected";
        }

        table.innerHTML += `
        <tr>
            <td>${d.name}</td>
            <td>${d.company}</td>
            <td>${d.package}</td>
            <td><span class="badge ${badgeClass}">${d.status}</span></td>
            <td>
                ${d.status === "Applied" ? `
                    <button class="btn btn-success btn-sm" onclick="updateStatus(${index}, 'Selected')">Select</button>
                    <button class="btn btn-danger btn-sm" onclick="updateStatus(${index}, 'Rejected')">Reject</button>
                ` : "-"}
            </td>
        </tr>`;
    });

    // UPDATE STATS
    document.getElementById("studentsCount").innerText = data.length;
    document.getElementById("companyCount").innerText = 3;
    document.getElementById("applicationCount").innerText = data.length;
    document.getElementById("selectedCount").innerText = selected;
}

// ===== UPDATE STATUS =====
function updateStatus(index, status){
    data[index].status = status;
    loadTable();
}

// ===== SEARCH =====
function searchTable(){
    let input = document.getElementById("search").value.toLowerCase();
    let rows = document.querySelectorAll("#tableBody tr");

    rows.forEach(row => {
        let text = row.innerText.toLowerCase();
        row.style.display = text.includes(input) ? "" : "none";
    });
}

// ===== ADD COMPANY =====
function addCompany(){
    let name = prompt("Enter Company Name:");
    if(name){
        alert(name + " added successfully!");
        document.getElementById("companyCount").innerText++;
    }
}

// INITIAL LOAD
loadTable();

</script>

</body>
</html>