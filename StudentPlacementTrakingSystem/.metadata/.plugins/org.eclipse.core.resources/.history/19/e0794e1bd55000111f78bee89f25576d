package org.placepro.controller;

import java.io.IOException;
import java.sql.PreparedStatement;

import org.placepro.DBconfig.DBConnection;
import java.sql.*;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

@WebServlet("/withdrawApplication")
public class WithdrawApplicationServlet extends HttpServlet {
    @Override
    protected void doPost(HttpServletRequest req, HttpServletResponse res) throws IOException {
        HttpSession session = req.getSession(false);
        if (session == null || session.getAttribute("user") == null) {
            res.sendRedirect("login.html");
            return;
        }

        int appId = Integer.parseInt(req.getParameter("appId"));

        try (Connection con = DBConnection.getConnection()) {
            // Delete from applications
            PreparedStatement ps = con.prepareStatement("DELETE FROM applications WHERE id=?");
            ps.setInt(1, appId);
            ps.executeUpdate();

            // Also delete from placements
            PreparedStatement ps2 = con.prepareStatement("DELETE FROM placements WHERE id=?");
            ps2.setInt(1, appId);
            ps2.executeUpdate();

            // Insert notification
            PreparedStatement ps3 = con.prepareStatement(
                "INSERT INTO notifications(student_id, message) " +
                "SELECT student_id, CONCAT('You withdrew your application for ', c.name) " +
                "FROM applications a JOIN company c ON a.company_id=c.id WHERE a.id=?"
            );
            ps3.setInt(1, appId);
            ps3.executeUpdate();

        } catch (Exception e) {
            e.printStackTrace();
        }

        res.sendRedirect("applications?withdraw=1");
    }




	/**
	 * @see HttpServlet#doPost(HttpServletRequest request, HttpServletResponse response)
	 */
	protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		// TODO Auto-generated method stub
		doGet(request, response);
	}

}
