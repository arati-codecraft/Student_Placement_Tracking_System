<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Student Dashboard - PlacePro</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body {
    margin:0;
    font-family:'Segoe UI', sans-serif;
    background:#f8fafc;
}

/* Sidebar */
.sidebar {
    width:220px;
    height:100vh;
    background:#1e293b;
    color:white;
    position:fixed;
    top:0;
    left:0;
    padding:20px 0;
}
.sidebar h3 {
    text-align:center;
    margin-bottom:30px;
}
.sidebar ul {
    list-style:none;
    padding:0;
}
.sidebar ul li {
    padding:12px 20px;
}
.sidebar ul li a {
    color:white;
    text-decoration:none;
    display:block;
}
.sidebar ul li a:hover {
    background:#2563eb;
    border-radius:6px;
}

/* Main Content */
.main {
    margin-left:220px;
    padding:30px;
}
.dashboard-header {
    display:flex;
    justify-content:space-between;
    align-items:center;
}
.dashboard-header h2 {
    font-weight:bold;
}
.dashboard-header img {
    height:120px;
}

/* Stats Cards */
.stats {
    display:flex;
    gap:20px;
    margin-top:30px;
}
.stats .card {
    flex:1;
    text-align:center;
    padding:20px;
    border-radius:12px;
    box-shadow:0 4px 10px rgba(0,0,0,0.1);
}
.stats .card h4 {
    margin-bottom:10px;
    color:#1e293b;
}
.stats .card p {
    font-size:22px;
    font-weight:bold;
    color:#2563eb;
}
</style>
</head>

<body>

<!-- Sidebar -->
<div class="sidebar">
    <h3>PlacePro</h3>
    <ul>
        <li><a href="#">Dashboard</a></li>
        <li><a href="#">Profile</a></li>
        <li><a href="#">Interviews</a></li>
        <li><a href="#">Applications</a></li>
        <li><a href="#">Apply</a></li>
        <li><a href="#">Coordinators</a></li>
        <li><a href="#">Logout</a></li>
    </ul>
</div>

<!-- Main Content -->
<div class="main">
    <div class="dashboard-header">
        <h2>Welcome 👋 Manage your placements and applications</h2>
        <img src="images/student.png" alt="Student Icon">
    </div>

    <!-- Stats Cards -->
    <div class="stats">
        <div class="card">
            <h4>Total Companies</h4>
            <p>0</p>
        </div>
        <div class="card">
            <h4>Applications</h4>
            <p>0</p>
        </div>
        <div class="card">
            <h4>Selected</h4>
            <p>0</p>
        </div>
        <div class="card">
            <h4>Interviews</h4>
            <p>0</p>
        </div>
    </div>
</div>

</body>
</html>
