package org.placepro.repositoryImpl;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.*;
import java.util.ArrayList;
import java.util.List;

import org.placepro.DBconfig.DBConnection;
import org.placepro.model.Placement;
import org.placepro.repository.PlacementRepository;

public class PlacementRepositoryImpl implements PlacementRepository {

	@Override
	public void save(int studentId, int companyId, String applyDate, String status) {
	    String sql = "INSERT INTO placements (student_id, company_id, apply_date, status) VALUES (?, ?, ?, ?)";
	    try (Connection con = DBConnection.getConnection();
	         PreparedStatement ps = con.prepareStatement(sql)) {
	        ps.setInt(1, studentId);
	        ps.setInt(2, companyId);
	        ps.setDate(3, java.sql.Date.valueOf(applyDate));
	        ps.setString(4, status);
	        ps.executeUpdate();
	    } catch (Exception e) {
	        e.printStackTrace();
	    }
	}


    @Override
    public List<Placement> findAll() {
        List<Placement> list = new ArrayList<>();
        String sql = "SELECT p.id, u.name, u.email, u.course, u.education, " +
                     "c.name AS companyName, c.packageAmount, p.status " +
                     "FROM placements p " +
                     "JOIN users u ON p.student_id = u.id " +
                     "JOIN company c ON p.company_id = c.id";
        try (Connection con = DBConnection.getConnection();
             Statement st = con.createStatement();
             ResultSet rs = st.executeQuery(sql)) {

            while (rs.next()) {
                Placement pl = new Placement();
                pl.setId(rs.getInt("id"));
                pl.setStudentName(rs.getString("name"));
                pl.setEmail(rs.getString("email"));
                pl.setCourse(rs.getString("course"));
                pl.setEducation(rs.getString("education"));
                pl.setCompanyName(rs.getString("companyName"));
                pl.setPackageAmount(rs.getDouble("packageAmount")); // or double if you change model
                pl.setStatus(rs.getString("status"));
                list.add(pl);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return list;
    }


    @Override
    public void updateStatus(int id, String status) {
        try (Connection con = DBConnection.getConnection()) {
            // Update placements
            PreparedStatement ps = con.prepareStatement("UPDATE placements SET status=? WHERE id=?");
            ps.setString(1, status);
            ps.setInt(2, id);
            ps.executeUpdate();

            // Also update applications (match student_id + company_id)
            PreparedStatement ps2 = con.prepareStatement(
                "UPDATE applications a " +
                "JOIN placements p ON a.student_id = p.student_id AND a.company_id = p.company_id " +
                "SET a.status=? WHERE p.id=?"
            );
            ps2.setString(1, status);
            ps2.setInt(2, id);
            ps2.executeUpdate();

            // Optional: add notification
            PreparedStatement ps3 = con.prepareStatement(
            	    "INSERT INTO notifications(student_id, message) " +
            	    "SELECT student_id, CONCAT('Your application with ', c.name, ' has been ', ?) " +
            	    "FROM placements p JOIN company c ON p.company_id = c.id WHERE p.id=?"
            	);
            	ps3.setString(1, status);
            	ps3.setInt(2, id);
            	ps3.executeUpdate();

        } catch (Exception e) {
            e.printStackTrace();
        }
    }


    @Override
    public int getTotalCompanies() {
        String sql = "SELECT COUNT(*) FROM companies";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {
            if (rs.next()) return rs.getInt(1);
        } catch (Exception e) {
            e.printStackTrace();
        }
        return 0;
    }

