<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Student Dashboard</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: 'Inter', sans-serif;
}

body{
    background:#f4f6ff;
    display:flex;
}

/* Sidebar */
.sidebar{
    width:250px;
    height:100vh;
    background:linear-gradient(180deg,#7c3aed,#5b21b6);
    color:white;
    padding:20px;
    position:fixed;
    left:0;
    top:0;
}

.logo{
    font-size:22px;
    font-weight:700;
    margin:10px 0 30px;
    display:flex;
    align-items:center;
    gap:10px;
}

.nav a{
    display:block;
    padding:12px 15px;
    color:white;
    text-decoration:none;
    margin:8px 0;
    border-radius:10px;
    transition:0.3s;
}

.nav a:hover,
.nav a.active{
    background:white;
    color:#5b21b6;
}

.logout{
    position:absolute;
    bottom:20px;
    width:210px;
    background:white;
    color:#5b21b6;
    padding:10px;
    border-radius:10px;
    text-align:center;
    font-weight:600;
}

/* Main */
.main{
    margin-left:250px;
    width:100%;
    padding:20px;
}

/* Topbar */
.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.search input{
    width:300px;
    padding:10px 15px;
    border:none;
    border-radius:20px;
    outline:none;
}

.user{
    display:flex;
    align-items:center;
    gap:10px;
    background:white;
    padding:8px 15px;
    border-radius:20px;
}

.avatar{
    width:35px;
    height:35px;
    border-radius:50%;
    background:#7c3aed;
}

/* Hero */
.hero{
    background:linear-gradient(135deg,#8b5cf6,#6366f1);
    color:white;
    padding:30px;
    border-radius:20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.hero h1{
    font-size:30px;
}

.hero p{
    opacity:0.9;
    margin-top:5px;
}

/* Cards */
.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
    margin-top:20px;
}

.card{
    background:white;
    padding:20px;
    border-radius:15px;
    text-align:center;
    box-shadow:0 5px 15px rgba(0,0,0,0.05);
}

.card h2{
    margin-top:10px;
    font-size:28px;
    color:#5b21b6;
}

.icon{
    font-size:22px;
    color:#7c3aed;
}

/* Responsive */
@media(max-width:1000px){
    .cards{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:600px){
    .sidebar{
        display:none;
    }
    .main{
        margin-left:0;
    }
    .cards{
        grid-template-columns:1fr;
    }
}
</style>
</head>

<body>

<!-- Sidebar -->
<div class="sidebar">
    <div class="logo">🎓 PlacePro</div>

    <div class="nav">
        <a class="active" href="#">Dashboard</a>
        <a href="#">Profile</a>
        <a href="#">Interviews</a>
        <a href="#">Applications</a>
        <a href="#">Apply</a>
        <a href="#">Coordinators</a>
    </div>

    <div class="logout">Logout</div>
</div>

<!-- Main -->
<div class="main">

    <!-- Topbar -->
    <div class="topbar">
        <div class="search">
            <input type="text" placeholder="Search...">
        </div>

        <div class="user">
            <div class="avatar"></div>
            Student
        </div>
    </div>

    <!-- Hero -->
    <div class="hero">
        <div>
            <h1>Welcome 👋</h1>
            <p>Manage your placements and applications</p>
        </div>
        <div style="font-size:60px;">🎓</div>
    </div>

    <!-- Cards -->
    <div class="cards">
        <div class="card">
            <div class="icon">🏢</div>
            <h2>0</h2>
            <p>Total Companies</p>
        </div>

        <div class="card">
            <div class="icon">📩</div>
            <h2>0</h2>
            <p>Applications</p>
        </div>

        <div class="card">
            <div class="icon">✔️</div>
            <h2>0</h2>
            <p>Selected</p>
        </div>

        <div class="card">
            <div class="icon">📅</div>
            <h2>0</h2>
            <p>Interviews</p>
        </div>
    </div>

</div>

</body>
</html>