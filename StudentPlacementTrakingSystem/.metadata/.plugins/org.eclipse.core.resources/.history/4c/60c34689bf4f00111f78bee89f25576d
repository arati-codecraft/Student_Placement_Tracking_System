package org.placepro.controller;

import java.io.IOException;
import java.io.PrintWriter;
import java.util.List;

import org.placepro.dao.ApplicationDao;
import org.placepro.daoImpl.ApplicationDaoImpl;
import org.placepro.model.Application;
import org.placepro.model.Users;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

@WebServlet("/applications")
public class ApplicationsServlet extends HttpServlet {
    private ApplicationDao dao = new ApplicationDaoImpl();

    @Override
    protected void doGet(HttpServletRequest req, HttpServletResponse res) throws IOException {
        HttpSession session = req.getSession(false);
        if (session == null || session.getAttribute("user") == null) {
            res.sendRedirect("login.html");
            return;
        }

        Users u = (Users) session.getAttribute("user");
        List<Application> apps = dao.getApplicationsByStudent(u.getId());

        res.setContentType("text/html");
        PrintWriter out = res.getWriter();

        out.println("<!DOCTYPE html>");
        out.println("<html lang='en'>");
        out.println("<head>");
        out.println("<meta charset='UTF-8'>");
        out.println("<meta name='viewport' content='width=device-width, initial-scale=1.0'>");
        out.println("<title>Applications</title>");
        out.println("<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css'>");
        out.println("<link rel='stylesheet' href='CSS/Student.css'>"); // external CSS file
        out.println("</head>");
        out.println("<body>");

        // Sidebar
        out.println("<div class='sidebar'>"
            + "<div class='logo'><i class='fas fa-graduation-cap'></i><h2>PlacePro</h2></div>"
            + "<div class='nav-links'>"
            + "<a href='studentDashboard' class='nav-item'><i class='fas fa-th-large'></i>Dashboard</a>"
            + "<a href='profile' class='nav-item'><i class='fas fa-user'></i>Profile</a>"
            + "<a href='scheduleInterview' class='nav-item'><i class='fas fa-calendar-alt'></i>Interviews</a>"
            + "<a href='applications' class='nav-item active'><i class='fas fa-file-alt'></i>Applications</a>"
            + "<a href='applyPlacement' class='nav-item'><i class='fas fa-paper-plane'></i>Apply</a>"
            + "<a href='coordinators' class='nav-item'><i class='fas fa-users'></i>Coordinators</a>"
            + "</div>"
            + "<button class='logout-btn'><i class='fas fa-sign-out-alt'></i>Logout</button>"
            + "</div>");

        // Main content
        out.println("<div class='main'>");

        // Topbar
        out.println("<div class='topbar'>"
            + "<div class='search-box'><input type='text' placeholder='Search here...'></div>"
            + "<div class='user-box'><div class='avatar'>S</div><div><strong>" + u.getName() + "</strong><br><small>Student Panel</small></div></div>"
            + "</div>");

        // Welcome card
        out.println("<div class='welcome-card'>"
            + "<div><h3>Applications Page</h3><h1>Welcome " + u.getName() + " 👋</h1><p>Here are your placement applications</p></div>"
            + "<div class='welcome-icon'><i class='fas fa-file-alt'></i></div>"
            + "</div>");

        // Applications table with company details
        out.println("<table class='applications-table'>");
        out.println("<tr><th>Company</th><th>Location</th><th>Package</th><th>Criteria</th><th>Date</th><th>Status</th></tr>");
        for (Application a : apps) {
            out.println("<tr>"
                + "<td>" + a.getCompanyName() + "</td>"
                + "<td>" + a.getLocation() + "</td>"
                + "<td>" + a.getPackageAmount() + "</td>"
                + "<td>" + a.getCriteria() + "</td>"
                + "<td>" + a.getApplyDate() + "</td>"
                + "<td>" + a.getStatus() + "</td>"
                + "</tr>");
        }
        out.println("</table>");

        out.println("</div></body></html>");
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        doGet(request, response);
    }
}
