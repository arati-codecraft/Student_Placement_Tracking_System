<!-- JS -->
<script>

function openModal(name, company, pack, role, story){
	document.getElementById("modal").style.display = "block";
	document.getElementById("name").innerText = name;
	document.getElementById("company").innerText = "Company: " + company;
	document.getElementById("package").innerText = "Package: " + pack;
	document.getElementById("role").innerText = "Role: " + role;
	document.getElementById("story").innerText = story;
}

function closeModal(){
	document.getElementById("modal").style.display = "none";
}

window.onclick = function(e){
	if(e.target == document.getElementById("modal")){
		closeModal();
	}
}

</script>

