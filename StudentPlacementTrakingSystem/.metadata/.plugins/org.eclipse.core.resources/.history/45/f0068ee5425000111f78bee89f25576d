<meta charset="UTF-8">
<title>Placement Success Stories</title>

<style>

/* RESET */
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	font-family: Segoe UI;
}

body {
	background: linear-gradient(135deg, #eef2ff, #f8fafc);
}

/* NAVBAR */
.navbar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 15px 40px;
	background: navy;
	color: white;
	position: sticky;
	top: 0;
}

.navbar a {
	color: white;
	text-decoration: none;
	margin: 0 10px;
}

.logo img {
	width: 180px;
}

/* HEADER */
.header {
	text-align: center;
	padding: 35px;
}

.header h1 {
	font-size: 42px;
	color: #0d6efd;
}

/* CONTAINER */
.container {
	width: 90%;
	margin: auto;
	display: flex;
	flex-wrap: wrap;
	gap: 25px;
	justify-content: center;
	padding-bottom: 40px;
}

/* CARD */
.card {
	width: 280px;
	background: white;
	border-radius: 15px;
	overflow: hidden;
	box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
	cursor: pointer;
	transition: 0.3s;
}

.card:hover {
	transform: scale(1.05);
	z-index:(-0);
}

/* IMAGE */
.card img {
	width: 100%;
	height: 300px;
	object-fit: cover;
}

/* DETAILS */
.details {
	padding: 12px;
	text-align: center;
}

.name {
	font-size: 18px;
	font-weight: bold;
	color: #222;
}

.company {
	font-size: 15px;
	color: #0d6efd;
	margin-top: 5px;
	font-weight: 600;
}

.package {
	background: #28a745;
	color: white;
	padding: 5px 10px;
	border-radius: 20px;
	display: inline-block;
	margin-top: 8px;
	font-size: 13px;
}

.role {
	color: gray;
	font-size: 13px;
	margin-top: 5px;
}

/* MODAL */
.modal {
	display: none;
	position: fixed;
	width: 100%;
	height: 100%;
	top: 0;
	left: 0;
	background: rgba(0, 0, 0, 0.6);
}

.modal-content {
	background: white;
	width: 450px;
	margin: 10% auto;
	padding: 20px;
	border-radius: 10px;
	position: relative;
}

.close {
	position: absolute;
	right: 10px;
	top: 5px;
	font-size: 22px;
	cursor: pointer;
}

</style>

</head>

