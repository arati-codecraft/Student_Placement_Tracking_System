// ================= BUTTON BLINK EFFECT =================

function blinkSignIn(){

    let btn = document.getElementById("signin");

    btn.classList.add("blink-btn");

    setTimeout(function(){

        btn.classList.remove("blink-btn");

    },2000);

}

// ================= START JOURNEY BUTTON =================

document.querySelector(".footer-top button").addEventListener("click",function(){

    blinkSignIn();

});

// ================= LEARN MORE BUTTONS =================

let learnBtns = document.querySelectorAll(".service-card a");

learnBtns.forEach(function(btn){

    btn.addEventListener("click",function(){

        blinkSignIn();

    });

});

//=============apply button===============
	
