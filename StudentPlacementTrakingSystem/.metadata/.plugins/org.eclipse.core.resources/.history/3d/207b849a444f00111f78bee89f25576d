package org.placepro.controller;

import java.io.IOException;
import java.io.PrintWriter;

import org.placepro.dao.UsersDao;
import org.placepro.daoImpl.UsersDaoImpl;
import org.placepro.model.Users;

import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@WebServlet("/updateUser")
public class UpdateUserServlet extends HttpServlet {
    private UsersDao userDao = new UsersDaoImpl();

    // Show pre-filled form
    @Override
    protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws IOException {
        int id = Integer.parseInt(req.getParameter("id"));
        Users u = userDao.getUserById(id);

        resp.setContentType("text/html");
        PrintWriter out = resp.getWriter();

        out.println("<!DOCTYPE html><html><head><title>Edit User</title>");
        out.println("<link href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css' rel='stylesheet'>");
        out.println("</head><body><div class='container mt-4'>");
        out.println("<h2>Edit User</h2>");
        out.println("<form method='post' action='updateUser'>");
        out.println("<input type='hidden' name='id' value='" + u.getId() + "'>");
        out.println("Name: <input type='text' name='name' value='" + u.getName() + "' required><br>");
        out.println("Email: <input type='email' name='email' value='" + u.getEmail() + "' required><br>");
        out.println("Mobile: <input type='text' name='mobile' value='" + u.getMobile() + "'><br>");
        out.println("Course: <input type='text' name='course' value='" + u.getCourse() + "'><br>");
        out.println("Status: <select name='status'>");
        out.println("<option " + ("Not Placed".equals(u.getStatus()) ? "selected" : "") + ">Not Placed</option>");
        out.println("<option " + ("Placed".equals(u.getStatus()) ? "selected" : "") + ">Placed</option>");
        out.println("<option " + ("Intern".equals(u.getStatus()) ? "selected" : "") + ">Intern</option>");
        out.println("</select><br>");
        out.println("<button type='submit' class='btn btn-success mt-2'>Update</button>");
        out.println("</form></div></body></html>");
    }

    // Handle update
    @Override
    protected void doPost(HttpServletRequest req, HttpServletResponse resp) throws IOException {
        int id = Integer.parseInt(req.getParameter("id"));

        // Fetch existing user so other fields remain unchanged
        Users u = userDao.getUserById(id);

        // ✅ Only update allowed fields
        u.setName(req.getParameter("name"));
        u.setEmail(req.getParameter("email"));
        u.setMobile(req.getParameter("mobile"));
        u.setCourse(req.getParameter("course"));
        u.setStatus(req.getParameter("status"));

        userDao.updateUser(u); // push changes to DB

        // Redirect to All Students page
        resp.sendRedirect(req.getContextPath() + "/viewUsers");
    }
}
