    @Override
    public void applyPlacement(int studentId, int companyId) {
        String sql = "INSERT INTO placements(student_id, company_id, apply_date, status) VALUES (?, ?, CURDATE(), 'Applied')";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {
