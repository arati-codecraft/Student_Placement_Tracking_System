    @Override
    @Override
    public void updateStatus(int placementId, String status) {
        try (Connection con = DBConnection.getConnection()) {
            // 1. Update placements
            PreparedStatement ps1 = con.prepareStatement(
                "UPDATE placements SET status=? WHERE id=?");
            ps1.setString(1, status);
            ps1.setInt(2, placementId);
            ps1.executeUpdate();

            // 2. Find student_id + company_id for this placement
            PreparedStatement psFind = con.prepareStatement(
                "SELECT student_id, company_id FROM placements WHERE id=?");
            psFind.setInt(1, placementId);
            ResultSet rs = psFind.executeQuery();

            if (rs.next()) {
                int studentId = rs.getInt("student_id");
                int companyId = rs.getInt("company_id");

                // 3. Update applications using student + company
                PreparedStatement ps2 = con.prepareStatement(
                    "UPDATE applications SET status=? WHERE student_id=? AND company_id=?");
                ps2.setString(1, status);
                ps2.setInt(2, studentId);
                ps2.setInt(3, companyId);
                ps2.executeUpdate();
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }




