package org.placepro.controller;

import java.io.IOException;
import java.io.PrintWriter;
import java.time.LocalDate;
import java.util.List;

import org.placepro.dao.ApplicationDao;
import org.placepro.dao.CompanyDao;
import org.placepro.daoImpl.ApplicationDaoImpl;
import org.placepro.daoImpl.CompanyDaoImpl;
import org.placepro.model.Application;
import org.placepro.model.Company;
import org.placepro.model.Users;

import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

@WebServlet("/applyPlacement")
public class ApplyPlacementServlet extends HttpServlet {

    private ApplicationDao appDao = new ApplicationDaoImpl();
    private CompanyDao companyDao = new CompanyDaoImpl();

    // =========================
    // SHOW COMPANY LIST
    // =========================
    @Override
    protected void doGet(HttpServletRequest req, HttpServletResponse res)
            throws IOException {

        HttpSession session = req.getSession(false);

        if (session == null || session.getAttribute("user") == null) {
            res.sendRedirect("login.html");
            return;
        }

        List<Company> companies = companyDao.getAllCompanies();

        res.setContentType("text/html");

        PrintWriter out = res.getWriter();

        out.println("<!DOCTYPE html>");
        out.println("<html>");
        out.println("<head>");

        out.println("<title>Apply Placement</title>");

        out.println("<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css'>");

        out.println("<link rel='stylesheet' href='CSS/Student.css'>");

        out.println("</head>");
        out.println("<body>");

        // SIDEBAR
        out.println("<div class='sidebar'>");

        out.println("<div class='logo'>");
        out.println("<h2>PlacePro</h2>");
        out.println("</div>");

        out.println("<div class='nav-links'>");

        out.println("<a href='studentDashboard' class='nav-item'>Dashboard</a>");
        out.println("<a href='profile' class='nav-item'>Profile</a>");
        out.println("<a href='applications' class='nav-item'>Applications</a>");
        out.println("<a href='applyPlacement' class='nav-item active'>Apply</a>");

        out.println("</div>");

        out.println("</div>");

        // MAIN
        out.println("<div class='main'>");

        out.println("<h2>Available Companies</h2>");

        out.println("<table class='applications-table'>");

        out.println("<tr>");
        out.println("<th>ID</th>");
        out.println("<th>Company</th>");
        out.println("<th>Location</th>");
        out.println("<th>Package</th>");
        out.println("<th>Action</th>");
        out.println("</tr>");

        for (Company c : companies) {

            out.println("<tr>");

            out.println("<td>" + c.getId() + "</td>");
            out.println("<td>" + c.getName() + "</td>");
            out.println("<td>" + c.getLocation() + "</td>");
            out.println("<td>" + c.getPackageAmount() + "</td>");

            out.println("<td>");

            out.println("<form method='post' action='applyPlacement'>");

            out.println("<input type='hidden' name='companyId' value='" + c.getId() + "'>");

            out.println("<button type='submit' class='btn-apply'>Apply</button>");

            out.println("</form>");

            out.println("</td>");

            out.println("</tr>");
        }

        out.println("</table>");

        out.println("</div>");

        out.println("</body>");
        out.println("</html>");
    }

    // =========================
    // APPLY COMPANY
    // =========================
    @Override
    protected void doPost(HttpServletRequest req, HttpServletResponse res)
            throws IOException {

        HttpSession session = req.getSession(false);

        if (session == null || session.getAttribute("user") == null) {

            res.sendRedirect("login.html");
            return;
        }

        try {

            Users user = (Users) session.getAttribute("user");

            String companyIdStr = req.getParameter("companyId");

            if (companyIdStr == null || companyIdStr.isEmpty()) {

                res.getWriter().println("<h2>Company ID Missing</h2>");
                return;
            }

            int companyId = Integer.parseInt(companyIdStr);

            Application app = new Application();

            app.setStudentId(user.getId());

            app.setCompanyId(companyId);

            app.setApplyDate(LocalDate.now().toString());

            app.setStatus("Applied");

            // SAVE APPLICATION
            appDao.apply(app);

            // REDIRECT
            res.sendRedirect("applications");

        } catch (Exception e) {

            e.printStackTrace();

            res.getWriter().println("<h2>Application Failed</h2>");
        }
    }
}