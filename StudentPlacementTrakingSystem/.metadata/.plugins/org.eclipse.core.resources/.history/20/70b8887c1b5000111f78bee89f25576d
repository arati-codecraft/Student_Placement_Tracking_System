@charset "UTF-8";
:root {
    --sidebar-width: 260px;
    --primary-blue: #4680ff;
    --accent-purple: #9333ea;
    --bg-light: #eef2ff;
}

/* Background */
body {
    margin: 0;
    font-family: 'Inter', 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, #eef2ff, #f8f9fd);
    color: #333;
}

/* Sidebar */
.sidebar { width: var(--sidebar-width); height: 100vh; position: fixed; background: #fff; border-right: 1px solid #e5e7eb; box-shadow: 4px 0 15px rgba(0,0,0,0.05); }
.sidebar-header { padding: 25px; border-bottom: 1px solid #f1f1f1; }
.sidebar-user { padding: 15px; margin: 15px; background: #f4f7fe; border-radius: 12px; display: flex; align-items: center; }
.user-img { width: 35px; height: 35px; border-radius: 8px; margin-right: 12px; background: var(--primary-blue); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px; box-shadow: 0 0 10px rgba(70,128,255,0.5); }
.nav-label { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #9aa4b2; padding: 20px 25px 10px; }

.sidebar a { display: flex; align-items: center; gap: 10px; padding: 12px 25px; color: #5b6b79; text-decoration: none; font-size: 14px; border-radius: 8px; margin: 4px 10px; transition: all 0.3s ease; }
.sidebar a:hover { background: #eef3ff; transform: translateX(5px); color: var(--primary-blue); box-shadow: inset 3px 0 0 var(--primary-blue); }
.sidebar a.active { background: #f9fafb; color: var(--primary-blue); font-weight: 600; }

.logout { color: #fff !important; background: #ef4444; margin-top: 15px; border-radius: 8px; text-align: center; transition: all 0.3s ease; }
.logout:hover { background: #dc2626 !important; transform: scale(1.05); }

/* Header */
.top-header { margin-left: var(--sidebar-width); height: 70px; background: #fff; display: flex; align-items: center; justify-content: space-between; padding: 0 30px; position: sticky; top: 0; border-bottom: 1px solid #e5e7eb; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }

/* Main */
.main { margin-left: var(--sidebar-width); padding: 30px; }

/* Hero Banner */
.hero-banner { background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-purple) 100%); border-radius: 16px; padding: 40px; color: #fff; margin-bottom: 30px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }

