package org.placepro.controller;

import java.io.IOException;
import java.io.PrintWriter;
import java.util.List;
import org.placepro.model.Users;
import org.placepro.dao.StudentDao;
import org.placepro.daoImpl.StudentDaoImpl;

import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

@WebServlet("/managestudent")
public class ManageStudentServlet extends HttpServlet {
    private StudentDao studentDao = new StudentDaoImpl();

    @Override
    protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws IOException {
        resp.setContentType("text/html");
        PrintWriter out = resp.getWriter();

        // Handle delete
        String deleteId = req.getParameter("deleteId");
        if (deleteId != null) {
            int id = Integer.parseInt(deleteId);
            studentDao.deleteStudent(id);
            resp.sendRedirect(req.getContextPath() + "/managestudent");
            return;
        }

        List<Users> students = studentDao.getAllStudents();

        out.println("<!DOCTYPE html><html lang='en'><head>");
        out.println("<meta charset='UTF-8'>");
        out.println("<meta name='viewport' content='width=device-width, initial-scale=1.0'>");
        out.println("<title>Manage Students</title>");
        out.println("<link href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet'>");
        out.println("<link rel='stylesheet' href='CSS/Admin.css'>"); // ✅ external CSS
        out.println("</head><body>");

        // Sidebar
        out.println("<div class='sidebar'>"
            + "<div class='sidebar-header'><h5 class='fw-bold text-primary mb-0'>Place<span class='text-muted'>Pro</span></h5></div>"
            + "<div class='sidebar-user'><div class='user-img'>A</div><div><div class='fw-bold' style='font-size:13px;'>Admin</div><div style='font-size:11px;color:#777;'>Administrator</div></div></div>"
            + "<div class='nav-label'>Navigation</div>"
            + "<a href='admindashboard'><i class='bi bi-speedometer2'></i>Dashboard</a>"
            + "<a class='active' href='managestudent'><i class='bi bi-people'></i>Manage Students</a>"
            + "<a href='managecompany'><i class='bi bi-building'></i>Manage Companies</a>"
            + "<a href='placementTracker'><i class='bi bi-journal-text'></i>Placement Tracker</a>"
            + "<a class='logout' href='logout'>Logout</a>"
            + "</div>");

        // Header
        out.println("<div class='top-header'>"
            + "<h4 class='mb-0'>Manage Students</h4>"
            + "<div><i class='bi bi-bell fs-5'></i><i class='bi bi-gear fs-5 ms-3'></i></div>"
            + "</div>");

        // Main content
        out.println("<div class='main'>"
            + "<div class='hero-banner'><h2>Student Management</h2><p>Add, edit, or remove students</p></div>");

        // Add form
        out.println("<div class='form-card mb-4'>"
            + "<form method='post' class='row g-3'>"
            + "<div class='col-md-5'><input type='text' name='name' class='form-control' placeholder='Name' required></div>"
            + "<div class='col-md-5'><input type='email' name='email' class='form-control' placeholder='Email' required></div>"
            + "<div class='col-md-2'><button type='submit' class='btn btn-primary w-100'>Add Student</button></div>"
            + "</form></div>");

        // Student table
        out.println("<div class='table-card'><h5>Student List</h5>");
        out.println("<table class='table mt-3'>");
        out.println("<thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Action</th></tr></thead><tbody>");
        for (Users u : students) {
            out.println("<tr>");
            out.println("<td>" + u.getId() + "</td>");
            out.println("<td>" + u.getName() + "</td>");
            out.println("<td>" + u.getEmail() + "</td>");
            out.println("<td>"
                + "<a href='managestudent?deleteId=" + u.getId() + "' class='btn btn-danger btn-sm'>Delete</a> "
                + "<a href='updateUser?id=" + u.getId() + "' class='btn btn-warning btn-sm'>Edit</a>"
                + "</td>");
            out.println("</tr>");
        }
        out.println("</tbody></table></div></div></body></html>");
    }

    @Override
    protected void doPost(HttpServletRequest req, HttpServletResponse resp) throws IOException {
        Users student = new Users();
        student.setName(req.getParameter("name"));
        student.setEmail(req.getParameter("email"));
        student.setRole("Student");

        // Defaults for required fields
        student.setPassword("default123");
        student.setStatus("Not Placed");
        student.setMobile("N/A");
        student.setCourse("N/A");
        student.setPercentage(0.0);
        student.setSkills("N/A");

        studentDao.addStudent(student);
        resp.sendRedirect(req.getContextPath() + "/managestudent");
    }
}


