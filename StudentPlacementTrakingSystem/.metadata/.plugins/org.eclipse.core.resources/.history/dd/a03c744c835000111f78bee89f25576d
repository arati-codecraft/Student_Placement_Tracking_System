package org.placepro.daoImpl;

import java.util.List;

import org.placepro.dao.ApplicationDao;
import org.placepro.model.Application;
import org.placepro.repository.ApplicationRepository;
import org.placepro.repository.PlacementRepository;
import org.placepro.repositoryImpl.ApplicationRepositoryImpl;
import org.placepro.repositoryImpl.PlacementRepositoryImpl;

public class ApplicationDaoImpl implements ApplicationDao {
    private ApplicationRepository repo = new ApplicationRepositoryImpl();
    private PlacementRepository placementRepo = new PlacementRepositoryImpl();
    @Override
    public void apply(Application app) {
        repo.save(app); // saves into applications

        placementRepo.save(
        	    app.getStudentId(),
        	    app.getCompanyId(),
        	    app.getPackageAmount(), // already a double, no need for parseDouble
        	    app.getApplyDate(),
        	    app.getStatus()
        	);


    }

    @Override
    public List<Application> getApplicationsByStudent(int studentId) {
        return repo.findByStudentId(studentId);
    }

    @Override
    public void updateStatus(int appId, String status) {
        repo.updateStatus(appId, status);
    }

    @Override
    public void deleteApplication(int appId) {
        repo.delete(appId);
    }

	
}
