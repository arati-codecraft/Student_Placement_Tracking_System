package org.placepro.controller;

import java.io.IOException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

import org.placepro.daoImpl.PlacementDaoImpl;
import org.placepro.model.Users;

@WebServlet("/studentDashboard")
public class StudentDashboardServlet extends HttpServlet {

    protected void doGet(HttpServletRequest req, HttpServletResponse res)
            throws IOException {

        HttpSession session = req.getSession(false);
        if (session == null || session.getAttribute("user") == null) {
            res.sendRedirect("login.html");
            return;
        }

        Users u = (Users) session.getAttribute("user");

        PlacementDaoImpl dao = new PlacementDaoImpl();

        int totalCompanies = dao.getTotalCompanies();
        int totalApplications = dao.getTotalApplications(u.getId());
        int selectedCount = dao.getSelectedCount(u.getId());
        int interviewCount = dao.getInterviewCount(u.getId());

        res.setContentType("text/html");
        res.getWriter().println("<!DOCTYPE html>");
        res.getWriter().println("<html lang='en'><head>");
        res.getWriter().println("<meta charset='UTF-8'>");
        res.getWriter().println("<meta name='viewport' content='width=device-width, initial-scale=1.0'>");
        res.getWriter().println("<title>PlacePro Dashboard</title>");
        res.getWriter().println("<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css'>");
        res.getWriter().println("<link rel='stylesheet' href='css/dashboard.css'>"); // external CSS
        res.getWriter().println("<style>");
        res.getWriter().println(":root{--primary:#7d3cff;--light:#b185ff;--bg:#f4f7fe;--white:#ffffff;--text:#333;--gray:#777;}");
        res.getWriter().println("*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif;}");
        res.getWriter().println("body{display:flex;background:var(--bg);min-height:100vh;}");
        res.getWriter().println(".sidebar{width:240px;background:var(--primary);color:white;padding:30px 20px;display:flex;flex-direction:column;}");
        res.getWriter().println(".logo{text-align:center;margin-bottom:40px;}.logo i{font-size:45px;margin-bottom:10px;}.logo h2{font-size:28px;}");
        res.getWriter().println(".nav-links{flex:1;}.nav-item{display:flex;align-items:center;gap:12px;color:white;text-decoration:none;padding:14px 16px;margin-bottom:10px;border-radius:12px;transition:0.3s;font-weight:500;}");
        res.getWriter().println(".nav-item:hover{background:white;color:var(--primary);} .active{background:white;color:var(--primary);}");
        res.getWriter().println(".logout-btn{background:white;color:var(--primary);border:none;padding:14px;border-radius:12px;cursor:pointer;font-size:15px;font-weight:bold;transition:0.3s;} .logout-btn:hover{transform:translateY(-2px);}");
        res.getWriter().println(".main{flex:1;padding:30px;} form{background:white;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,0.05);max-width:500px;} form input[type=text]{width:100%;padding:10px;margin-bottom:15px;border:1px solid #ccc;border-radius:8px;} form input[type=submit]{background:var(--primary);color:white;border:none;padding:12px 20px;border-radius:8px;cursor:pointer;font-weight:bold;} form input[type=submit]:hover{background:var(--light);}");
        res.getWriter().println("</style>");
        res.getWriter().println("</head><body>");

        // Sidebar
        res.getWriter().println("<div class='sidebar'>"
            + "<div class='logo'><i class='fas fa-graduation-cap'></i><h2>PlacePro</h2></div>"
            + "<div class='nav-links'>"
            + "<a href='studentDashboard' class='nav-item active'><i class='fas fa-th-large'></i>Dashboard</a>"
            + "<a href='profile' class='nav-item'><i class='fas fa-user'></i>Profile</a>"
            + "<a href='scheduleInterview' class='nav-item'><i class='fas fa-calendar-alt'></i>Interviews</a>"
            + "<a href='placementTracker' class='nav-item'><i class='fas fa-file-alt'></i>Applications</a>"
            + "<a href='applyPlacement' class='nav-item'><i class='fas fa-paper-plane'></i>Apply</a>"
            + "<a href='coordinators' class='nav-item'><i class='fas fa-users'></i>Coordinators</a>"
            + "</div>"
            + "<button class='logout-btn'><i class='fas fa-sign-out-alt'></i>Logout</button>"
            + "</div>");

        // Main content
        res.getWriter().println("<div class='main'>"
            + "<div class='topbar'>"
            + "<div class='search-box'><input type='text' placeholder='Search here...'></div>"
            + "<div class='user-box'><div class='avatar'>S</div><div><strong>" + u.getName() + "</strong><br><small>Student Panel</small></div></div>"
            + "</div>"
            + "<div class='welcome-card'><div><h3>Student Dashboard</h3><h1>Welcome " + u.getName() + " 👋</h1><p>Manage your placements and applications easily</p></div><div class='welcome-icon'><i class='fas fa-user-graduate'></i></div></div>"
            + "<div class='stats'>"
            + "<div class='card'><i class='fas fa-building'></i><span class='count'>" + totalCompanies + "</span><div class='label'>Total Companies</div></div>"
            + "<div class='card'><i class='fas fa-paper-plane'></i><span class='count'>" + totalApplications + "</span><div class='label'>Applications</div></div>"
            + "<div class='card'><i class='fas fa-check-circle'></i><span class='count'>" + selectedCount + "</span><div class='label'>Selected</div></div>"
            + "<div class='card'><i class='fas fa-calendar-check'></i><span class='count'>" + interviewCount + "</span><div class='label'>Interviews</div></div>"
            + "</div></div>");

        res.getWriter().println("</body></html>");
    }
}
