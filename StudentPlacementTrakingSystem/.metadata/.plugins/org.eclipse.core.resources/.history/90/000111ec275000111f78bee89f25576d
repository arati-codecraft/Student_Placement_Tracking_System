@charset "UTF-8";

:root {
    --sidebar-width: 260px;
    --primary-blue: #4680ff;
    --accent-purple: #9333ea;
    --bg-light: #eef2ff;
}

/* =========================
   GLOBAL
========================= */
body {
    margin: 0;
    font-family: 'Inter','Segoe UI',sans-serif;
    background: linear-gradient(135deg, var(--bg-light), #f8f9fd);
    color: #333;
}

/* =========================
   SIDEBAR
========================= */
.sidebar {
    width: var(--sidebar-width);
    height: 100vh;
    position: fixed;
    background: #fff;
    border-right: 1px solid #e5e7eb;
    box-shadow: 4px 0 15px rgba(0,0,0,0.05);
    z-index: 1000;
    padding-top: 20px;
}
.sidebar-header {
    padding: 25px;
    border-bottom: 1px solid #f1f1f1;
    font-size: 18px;
}
.sidebar-user {
    padding: 15px;
    margin: 15px;
    background: #f4f7fe;
    border-radius: 12px;
    display: flex;
    align-items: center;
}
.user-img {
    width: 35px;
    height: 35px;
    border-radius: 8px;
    margin-right: 12px;
    background: var(--primary-blue);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 14px;
    box-shadow: 0 0 10px rgba(70,128,255,0.5);
}
.nav-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #9aa4b2;
    padding: 20px 25px 10px;
}

/* Sidebar Links */
.sidebar a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 25px;
    color: #5b6b79;
    text-decoration: none;
    font-size: 14px;
    border-radius: 8px;
    margin: 4px 10px;
    transition: all 0.3s ease;
}
.sidebar i { font-size: 18px; }
.sidebar a:hover {
    background: #eef3ff;
    transform: translateX(5px);
    color: var(--primary-blue);
    box-shadow: inset 3px 0 0 var(--primary-blue);
}
.sidebar a.active {
    background: #eef3ff;
    color: var(--primary-blue);
    font-weight: 600;
    border-right: 3px solid var(--primary-blue);
}

/* Logout Button */
.logout {
    color: #fff !important;
    background: #ef4444;
    margin-top: 15px;
    border-radius: 8px;
    text-align: center;
    transition: all 0.3s ease;
}
.logout:hover {
    background: #dc2626 !important;
    transform: scale(1.05);
}

/* =========================
   HEADER
========================= */
.top-header {
    margin-left: var(--sidebar-width);
    height: 70px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
    position: sticky;
    top: 0;
    border-bottom: 1px solid #e5e7eb;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}
.search-box {
    background: #f3f5f9;
    border: none;
    border-radius: 8px;
    padding: 8px 15px;
    width: 250px;
    transition: all 0.3s ease;
}
.search-box:focus {
    outline: none;
    box-shadow: 0 0 10px rgba(70,128,255,0.6);
    border: 1px solid var(--primary-blue);
}

/* =========================
   MAIN
========================= */
.main { margin-left: var(--sidebar-width); padding: 30px; }

/* =========================
   HERO BANNER
========================= */
.hero-banner {
    background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-purple) 100%);
    border-radius: 16px;
    padding: 40px;
    color: #fff;
    margin-bottom: 30px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    animation: fadeIn 1s ease;
}
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}

/* =========================
   FORM CARD
========================= */
.form-card {
    background: #fff;
    border-radius: 12px;
    padding: 30px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    max-width: 900px;
    margin: auto;
    margin-bottom: 25px;
}
.form-label { font-weight: 600; color: #374151; }
.form-control, .form-select {
    border-radius: 8px;
    border: 1px solid #d1d5db;
    padding: 10px;
    transition: all 0.3s ease;
}
.form-control:focus, .form-select:focus {
    border-color: var(--primary-blue);
    box-shadow: 0 0 8px rgba(70,128,255,0.4);
    outline: none;
}

/* =========================
   TABLE CARD
========================= */
.table-card {
    background: #fff;
    border-radius: 12px;
    padding: 25px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
}
.table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
}
.table thead {
    background: linear-gradient(90deg, var(--primary-blue), var(--accent-purple));
    color: #fff;
}
.table thead th { text-align: center; font-weight: 600; padding: 12px; }
.table tbody td { text-align: center; padding: 12px; border-bottom: 1px solid #e5e7eb; }
.table tbody tr { transition: background 0.3s ease, transform 0.2s ease; }
.table tbody tr:hover { background: #f9fafb; transform: scale(1.01); }

/* =========================
   STATUS BADGES
========================= */
.status-badge {
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    display: inline-block;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    transition: transform 0.2s ease;
}
.status-badge:hover { transform: scale(1.1); }
.badge-applied { background: linear-gradient(90deg,#f59e0b,#fbbf24); }
.badge-selected { background: linear-gradient(90deg,#22c55e,#4ade80); }
.badge-rejected { background: linear-gradient(90deg,#ef4444,#f87171); }

/* =========================
   BUTTONS
========================= */
.btn-primary { background: var(--primary-blue); border: none; }
.btn-primary:hover { background: #2b57d5; }
.btn-success {
    background: #22c55e;
    border: none;
    font-weight: 600;
    padding: 12px;
    border-radius: 8px;
    transition: all 0.3s ease;
}
.btn-success:hover { background: #16a34a; transform: scale(1.03); }
.btn-danger { background: #ef4444; border: none; color: #fff; }
.btn-danger:hover { background: #dc2626; transform: scale(1.05); }
.btn-warning { background: #f59e0b; border: none; color: #fff; }
.btn-warning:hover { background: #d97706; transform: scale(1.05); }
