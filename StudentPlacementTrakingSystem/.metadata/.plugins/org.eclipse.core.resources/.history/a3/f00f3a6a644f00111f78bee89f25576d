package org.placepro.controller;

import java.io.IOException;
import java.io.PrintWriter;
import java.util.List;

import org.placepro.dao.AdminDao;
import org.placepro.daoImpl.AdminDaoImpl;
import org.placepro.model.Placement;

import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

@WebServlet("/admindashboard")
public class AdminDashboardServlet extends HttpServlet {

    private AdminDao dao = new AdminDaoImpl();

    protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws IOException {

        // ✅ SESSION CHECK
        HttpSession session = req.getSession(false);
        if (session == null || session.getAttribute("role") == null) {
            resp.sendRedirect("login.html");
            return;
        }

        resp.setContentType("text/html");
        PrintWriter out = resp.getWriter();

        // ✅ COUNTS
        int students = dao.totalStudents();
        int companies = dao.totalCompanies();
        int applications = dao.totalApplications();
        int selected = dao.totalSelected();

        // ✅ DATA
        List<Placement> list = dao.getAllPlacements();

        // ✅ HTML START
        out.println("<!DOCTYPE html>");
        out.println("<html><head><title>Admin Dashboard</title>");

        out.println("<link href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css' rel='stylesheet'>");

        out.println("<style>");
        out.println("body{margin:0;font-family:'Segoe UI';background:#f1f5f9;}");
        out.println(".sidebar{width:250px;height:100vh;position:fixed;background:#0f172a;color:white;padding:20px;}");
        out.println(".sidebar a{display:block;color:#cbd5f5;text-decoration:none;margin:15px 0;}");
        out.println(".sidebar a:hover{color:white;}");
        out.println(".main{margin-left:250px;padding:30px;}");
        out.println(".card-box{border-radius:15px;padding:20px;background:white;box-shadow:0 4px 15px rgba(0,0,0,0.1);}");
        out.println(".stat{font-size:30px;font-weight:bold;}");
        out.println(".badge-applied{background:orange;}");
        out.println(".badge-selected{background:green;}");
        out.println(".badge-rejected{background:red;}");
        out.println("</style>");

        out.println("</head><body>");

        // ✅ SIDEBAR
        out.println("<div class='sidebar'>");
        out.println("<h4>Admin Panel</h4>");
        out.println("<a href='admindashboard'>Dashboard</a>");
        out.println("<a href='managestudent'>Manage Students</a>");
        out.println("<a href='managecompany'>Manage Companies</a>");
        out.println("<a href='placementTracker'>Placement Tracker</a>");
        out.println("<a href='logout'><button class='btn btn-danger mt-4 w-100'>Logout</button></a>");
        out.println("</div>");

        // ✅ MAIN
        out.println("<div class='main'>");

        out.println("<h3>Admin Dashboard</h3>");
        out.println("<p>Welcome, Admin 👋</p>");

        // ✅ CARDS
        out.println("<div class='row mb-4'>");

        out.println("<div class='col-md-3'><div class='card-box'><p>Total Students</p><div class='stat text-primary'>" + students + "</div></div></div>");
        out.println("<div class='col-md-3'><div class='card-box'><p>Total Companies</p><div class='stat text-success'>" + companies + "</div></div></div>");
        out.println("<div class='col-md-3'><div class='card-box'><p>Applications</p><div class='stat text-warning'>" + applications + "</div></div></div>");
        out.println("<div class='col-md-3'><div class='card-box'><p>Selected Students</p><div class='stat text-info'>" + selected + "</div></div></div>");

        out.println("</div>");

        // ✅ TABLE
        out.println("<div class='card-box'>");
        out.println("<h5>Placement Applications</h5>");

        out.println("<table class='table table-bordered table-hover'>");
        out.println("<thead class='table-dark'>");
        out.println("<tr>");
        out.println("<th>ID</th><th>Name</th><th>Email</th><th>Course</th><th>Education</th><th>Company</th><th>Package</th><th>Status</th><th>Action</th>");
        out.println("</tr></thead>");

        out.println("<tbody>");

        for (Placement p : list) {

            String badgeClass = "badge-applied";
            if ("Selected".equalsIgnoreCase(p.getStatus())) badgeClass = "badge-selected";
            else if ("Rejected".equalsIgnoreCase(p.getStatus())) badgeClass = "badge-rejected";

            out.println("<tr>");

            out.println("<td>" + p.getId() + "</td>");
            out.println("<td>" + p.getStudentName() + "</td>");
            out.println("<td>" + p.getEmail() + "</td>");
            out.println("<td>" + p.getCourse() + "</td>");
            out.println("<td>" + p.getEducation() + "</td>");
            out.println("<td>" + p.getCompanyName() + "</td>");
            out.println("<td>" + p.getPackageAmount() + "</td>");
            out.println("<td><span class='badge " + badgeClass + "'>" + p.getStatus() + "</span></td>");

            // ✅ ACTION BUTTONS
            out.println("<td>");
            out.println("<a href='updateStatus?id=" + p.getId() + "&status=Selected' class='btn btn-success btn-sm'>Select</a> ");
            out.println("<a href='updateStatus?id=" + p.getId() + "&status=Rejected' class='btn btn-danger btn-sm'>Reject</a>");
            out.println("</td>");

            out.println("</tr>");
        }

        out.println("</tbody></table>");
        out.println("</div>");

        out.println("</div>"); // main

        out.println("</body></html>");
    }
}