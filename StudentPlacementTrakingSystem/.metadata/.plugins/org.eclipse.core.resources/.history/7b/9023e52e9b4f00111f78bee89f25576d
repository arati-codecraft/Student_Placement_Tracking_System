package org.placepro.controller;

import java.io.IOException;
import java.io.PrintWriter;
import java.sql.Connection;
import java.sql.ResultSet;

import org.placepro.DBconfig.DBConnection;

import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

@WebServlet("/studentDashboard")
public class StudentDashboardServlet extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest req, HttpServletResponse resp)
            throws IOException {

        try {

            HttpSession session = req.getSession(false);

            if (session == null || session.getAttribute("userId") == null) {

                resp.setContentType("application/json");

                resp.getWriter().write(
                    "{\"error\":\"Login Required\"}"
                );

                return;
            }

            int studentId = (int) session.getAttribute("userId");

            Connection con = DBConnection.getConnection();

            int companies = getCount(con,
                    "SELECT COUNT(*) FROM company");

            int applied = getCount(con,
                    "SELECT COUNT(*) FROM placements WHERE student_id="
                            + studentId);

            int selected = getCount(con,
                    "SELECT COUNT(*) FROM placements WHERE student_id="
                            + studentId
                            + " AND status='Selected'");

            int interviews = getCount(con,
                    "SELECT COUNT(*) FROM interview i "
                            + "JOIN placements p "
                            + "ON i.placement_id=p.id "
                            + "WHERE p.student_id="
                            + studentId);

            resp.setContentType("application/json");

            PrintWriter out = resp.getWriter();

            out.print("{");
            out.print("\"companies\":" + companies + ",");
            out.print("\"applied\":" + applied + ",");
            out.print("\"selected\":" + selected + ",");
            out.print("\"interviews\":" + interviews);
            out.print("}");

        } catch (Exception e) {

            e.printStackTrace();

            resp.setContentType("application/json");

            resp.getWriter().write(
                "{\"error\":\"Server Error\"}"
            );
        }
    }

    private int getCount(Connection con, String sql)
            throws Exception {

        ResultSet rs = con.createStatement()
                .executeQuery(sql);

        if (rs.next()) {
            return rs.getInt(1);
        }

        return 0;
    }
}