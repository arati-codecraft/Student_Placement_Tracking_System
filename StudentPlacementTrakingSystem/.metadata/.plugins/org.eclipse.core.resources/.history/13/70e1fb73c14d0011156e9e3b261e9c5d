package org.placepro.controller;

import java.io.IOException;

import org.placepro.dao.AdminDao;
import org.placepro.dao.UsersLoginDao;
import org.placepro.repositoryImpl.AdminDaoImpl;
import org.placepro.repositoryImpl.UsersRepositoryImpl;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

/**
 * Servlet implementation class StudentLoginServlet
 */
@WebServlet("/studentlogin")
public class UsersLoginServlet extends HttpServlet {
	private static final long serialVersionUID = 1L;
       
    /**
     * @see HttpServlet#HttpServlet()
     */
    public UsersLoginServlet() {
        super();
        // TODO Auto-generated constructor stub
    }

    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        String email = request.getParameter("email");
        String password = request.getParameter("password");
        String role = request.getParameter("role");

        HttpSession session = request.getSession();

        // 🔹 STUDENT LOGIN
        if (role.equals("Student")) {
  
            UsersLoginDao dao = new UsersRepositoryImpl();
            boolean isValid = dao.validateLogin(email, password);
            System.out.println(isValid);

            if (isValid) {
                //session.setAttribute("studentEmail", email);
                response.sendRedirect("Student/StudentDashboard.html"); // ✅ redirect
            } else {
                response.sendRedirect("login.html?error=InvalidStudent");
            }

        }

        // 🔹 ADMIN LOGIN
        else if ("Admin".equalsIgnoreCase(role)) {

            AdminDao dao = new AdminDaoImpl();
            boolean isValid = dao.validateLogin(email, password);

            if (isValid) {
                session.setAttribute("adminEmail", email);
                response.sendRedirect("Admin/AdminDashboard.html"); // ✅ redirect
            } else {
                response.sendRedirect("login.html?error=InvalidAdmin");
            }

        }

        else {
            response.sendRedirect("login.html?error=RoleError");
        }
    }

	protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		// TODO Auto-generated method stub
		doGet(request, response);
	}

}
