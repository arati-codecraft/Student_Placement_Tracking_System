package org.placepro.repositoryImpl;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.ArrayList;
import java.util.List;

import org.placepro.db.DBConnection;   // ✅ adjust to your actual package
import org.placepro.model.Placement;
import org.placepro.repository.PlacementRepository;

public class PlacementRepositoryImpl implements PlacementRepository {

    @Override
    public void save(int studentId, int companyId, double packageAmount) {
        String sql = "INSERT INTO placements (student_id, company_id, package, apply_date, status) VALUES (?, ?, ?, CURDATE(), 'Applied')";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setInt(1, studentId);
            ps.setInt(2, companyId);
            ps.setDouble(3, packageAmount);
            ps.executeUpdate();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    @Override
    public List<Placement> findAll() {
        List<Placement> list = new ArrayList<>();
        String sql = "SELECT p.id, u.name, u.email, u.course, c.company_name, c.package, p.status " +
                     "FROM placements p " +
                     "JOIN users u ON p.student_id = u.id " +
                     "JOIN companies c ON p.company_id = c.id";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                Placement p = new Placement();
                p.setId(rs.getInt("id"));
                p.setStudentName(rs.getString("name"));
                p.setEmail(rs.getString("email"));
                p.setCourse(rs.getString("course"));
                p.setCompanyName(rs.getString("company_name"));
                p.setPackageAmount(rs.getString("package")); // ✅ double
                p.setStatus(rs.getString("status"));
                list.add(p);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return list;
    }

    @Override
    public void updateStatus(int id, String status) {
        String sql = "UPDATE placements SET status=? WHERE id=?";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, status);
            ps.setInt(2, id);
            ps.executeUpdate();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    @Override
    public int getTotalCompanies() {
        String sql = "SELECT COUNT(*) FROM companies";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {
            if (rs.next()) return rs.getInt(1);
        } catch (Exception e) {
            e.printStackTrace();
        }
        return 0;
    }

    @Override
    public int getTotalApplications(int studentId) {
        String sql = "SELECT COUNT(*) FROM placements WHERE student_id=?";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setInt(1, studentId);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) return rs.getInt(1);
        } catch (Exception e) {
            e.printStackTrace();
        }
        return 0;
    }

    @Override
    public int getSelectedCount(int studentId) {
        String sql = "SELECT COUNT(*) FROM placements WHERE student_id=? AND status='Selected'";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setInt(1, studentId);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) return rs.getInt(1);
        } catch (Exception e) {
            e.printStackTrace();
        }
        return 0;
    }

    @Override
    public int getInterviewCount(int studentId) {
        String sql = "SELECT COUNT(*) FROM placements WHERE student_id=? AND status='Interview'";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setInt(1, studentId);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) return rs.getInt(1);
        } catch (Exception e) {
            e.printStackTrace();
        }
        return 0;
    }

    @Override
    public void applyPlacement(int studentId, int companyId) {
        String sql = "INSERT INTO placements(student_id, company_id, apply_date, status) VALUES (?, ?, CURDATE(), 'Applied')";
        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setInt(1, studentId);
            ps.setInt(2, companyId);
            ps.executeUpdate();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
