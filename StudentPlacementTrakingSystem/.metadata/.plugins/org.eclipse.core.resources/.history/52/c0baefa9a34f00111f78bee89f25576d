import java.io.IOException;

import org.placepro.daoImpl.UsersDaoImpl;
import org.placepro.model.Users;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

@WebServlet("/profile")
public class ProfileServlet extends HttpServlet {

    protected void doGet(HttpServletRequest req, HttpServletResponse res)
            throws IOException {

        HttpSession session = req.getSession(false);
        if (session == null || session.getAttribute("user") == null) {
            res.sendRedirect("login.html");
            return;
        }

        Users u = (Users) session.getAttribute("user");

        res.setContentType("text/html");
        res.getWriter().println("<!DOCTYPE html>");
        res.getWriter().println("<html lang='en'><head>");
        res.getWriter().println("<meta charset='UTF-8'>");
        res.getWriter().println("<meta name='viewport' content='width=device-width, initial-scale=1.0'>");
        res.getWriter().println("<title>Profile</title>");
        res.getWriter().println("<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css'>");

        // ✅ Inline CSS (your full block)
        res.getWriter().println("<style>");
        res.getWriter().println("/* paste your CSS block here exactly as you shared */");
        res.getWriter().println("</style>");

        res.getWriter().println("</head><body>");

        // Sidebar
        res.getWriter().println("<div class='sidebar'>"
            + "<div class='logo'><i class='fas fa-graduation-cap'></i><h2>PlacePro</h2></div>"
            + "<div class='nav-links'>"
            + "<a href='studentDashboard' class='nav-item'><i class='fas fa-th-large'></i>Dashboard</a>"
            + "<a href='profile' class='nav-item active'><i class='fas fa-user'></i>Profile</a>"
            + "<a href='scheduleInterview' class='nav-item'><i class='fas fa-calendar-alt'></i>Interviews</a>"
            + "<a href='placementTracker' class='nav-item'><i class='fas fa-file-alt'></i>Applications</a>"
            + "<a href='applyPlacement' class='nav-item'><i class='fas fa-paper-plane'></i>Apply</a>"
            + "<a href='coordinators' class='nav-item'><i class='fas fa-users'></i>Coordinators</a>"
            + "</div>"
            + "<button class='logout-btn'><i class='fas fa-sign-out-alt'></i>Logout</button>"
            + "</div>");

        // Main content
        res.getWriter().println("<div class='main'>");

        // Topbar
        res.getWriter().println("<div class='topbar'>"
            + "<div class='search-box'><input type='text' placeholder='Search here...'></div>"
            + "<div class='user-box'><div class='avatar'>S</div><div><strong>" + u.getName() + "</strong><br><small>Student Panel</small></div></div>"
            + "</div>");

        // Welcome card
        res.getWriter().println("<div class='welcome-card'>"
            + "<div><h3>Profile Page</h3><h1>Welcome " + u.getName() + " 👋</h1><p>Edit your details below</p></div>"
            + "<div class='welcome-icon'><i class='fas fa-user-graduate'></i></div>"
            + "</div>");

        // Profile form
        res.getWriter().println("<form method='post' action='profile'>"
            + "Name: <input type='text' name='name' value='" + u.getName() + "'><br>"
            + "Email: <input type='text' name='email' value='" + u.getEmail() + "' readonly><br>"
            + "Mobile: <input type='text' name='mobile' value='" + u.getMobile() + "'><br>"
            + "Course: <input type='text' name='course' value='" + u.getCourse() + "'><br>"
            + "Percentage: <input type='text' name='percentage' value='" + u.getPercentage() + "'><br>"
            + "Skills: <input type='text' name='skills' value='" + u.getSkills() + "'><br>"
            + "<input type='submit' value='Update Profile'>"
            + "</form>");

        res.getWriter().println("</div>"); // end main
        res.getWriter().println("</body></html>");
    }

    protected void doPost(HttpServletRequest req, HttpServletResponse res)
            throws IOException, ServletException {

        HttpSession session = req.getSession(false);
        if (session == null || session.getAttribute("user") == null) {
            res.sendRedirect("login.html");
            return;
        }

        Users u = (Users) session.getAttribute("user");

        // Update with new values
        u.setName(req.getParameter("name"));
        u.setMobile(req.getParameter("mobile"));
        u.setCourse(req.getParameter("course"));
        u.setPercentage(Double.parseDouble(req.getParameter("percentage")));
        u.setSkills(req.getParameter("skills"));

        // Save to DB
        UsersDaoImpl dao = new UsersDaoImpl();
        dao.updateUser(u);

        // Refresh session
        session.setAttribute("user", u);

        // Redirect back to dashboard
        res.sendRedirect("studentDashboard");
    }
}
