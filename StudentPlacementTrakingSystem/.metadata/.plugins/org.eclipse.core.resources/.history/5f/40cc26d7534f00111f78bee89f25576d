package org.placepro.repositoryImpl;

import java.sql.*;
import java.util.*;
import org.placepro.DBconfig.DBConnection;
import org.placepro.model.Placement;
import org.placepro.repository.PlacementRepository;

public class PlacementRepositoryImpl extends DBConnection implements PlacementRepository {

    @Override
    public void save(int studentId, int companyId, double packageAmount) {
        try (Connection con = DBConnection.getConnection()) {
            PreparedStatement ps = con.prepareStatement(
                "INSERT INTO placement(student_id, company_id, package, status) VALUES(?,?,?,?)"
            );
            ps.setInt(1, studentId);
            ps.setInt(2, companyId);
            ps.setDouble(3, packageAmount);
            ps.setString(4, "Applied"); // default status
            ps.executeUpdate();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    @Override
    public List<Placement> findAll() {
        List<Placement> list = new ArrayList<>();
        try (Connection con = DBConnection.getConnection();
             Statement st = con.createStatement();
             ResultSet rs = st.executeQuery(
                 "SELECT p.id, u.name AS studentName, c.name AS companyName, p.package, p.status " +
                 "FROM placement p " +
                 "JOIN users u ON p.student_id = u.id " +
                 "JOIN company c ON p.company_id = c.id"
             )) {
            while (rs.next()) {
                Placement pl = new Placement();
                pl.setId(rs.getInt("id"));
                pl.setStudentName(rs.getString("studentName"));
                pl.setCompanyName(rs.getString("companyName"));
                pl.setPackageAmount(rs.getDouble("package"));
                pl.setStatus(rs.getString("status"));
                list.add(pl);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return list;
    }

    @Override
    public void updateStatus(int id, String status) {
        try (Connection con = DBConnection.getConnection()) {
            PreparedStatement ps = con.prepareStatement("UPDATE placement SET status=? WHERE id=?");
            ps.setString(1, status);
            ps.setInt(2, id);
            ps.executeUpdate();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
