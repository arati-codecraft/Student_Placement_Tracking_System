package org.placepro.controller;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;

/**
 * Servlet implementation class InterviewServlet
 */
@WebServlet("/scheduleInterview")
public class InterviewServlet extends HttpServlet {

    protected void doPost(HttpServletRequest req, HttpServletResponse resp)
            throws IOException {

        try {
            Connection con = DBConnection.getConnection();

            PreparedStatement ps = con.prepareStatement(
                "INSERT INTO interview(placement_id, interview_date, interview_time, location) VALUES (?, ?, ?, ?)"
            );

            ps.setInt(1, Integer.parseInt(req.getParameter("placement_id")));
            ps.setString(2, req.getParameter("date"));
            ps.setString(3, req.getParameter("time"));
            ps.setString(4, req.getParameter("location"));

            ps.executeUpdate();

            resp.sendRedirect("admindashboard");

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}

	/**
	 * @see HttpServlet#doPost(HttpServletRequest request, HttpServletResponse response)
	 */
	protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		// TODO Auto-generated method stub
		doGet(request, response);
	}

}
